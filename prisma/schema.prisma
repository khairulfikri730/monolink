// BioLink Platform — Prisma Schema
// PRD Section 32: Data Model

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------
model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  password     String    // bcrypt hash
  role         Role      @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  profile      Profile?

  @@map("users")
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// ---------------------------------------------------------------------------
// Profile
// ---------------------------------------------------------------------------
model Profile {
  id           String    @id @default(cuid())
  userId       String    @unique @map("user_id")
  username     String    @unique
  displayName  String    @map("display_name")
  bio          String?   @db.Text
  profileImage String?   @map("profile_image")
  logo         String?
  location     String?
  website      String?
  isPublished  Boolean   @default(true) @map("is_published")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links        Link[]
  socialLinks  SocialLink[]
  theme        Theme?
  analytics    AnalyticsEvent[]

  @@index([username])
  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Link
// ---------------------------------------------------------------------------
model Link {
  id          String    @id @default(cuid())
  profileId   String    @map("profile_id")
  title       String
  url         String    @db.Text
  type        LinkType  @default(CUSTOM)
  icon        String?
  thumbnail   String?
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  analytics   AnalyticsEvent[]

  @@index([profileId, sortOrder])
  @@map("links")
}

enum LinkType {
  // Social
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  LINKEDIN
  X_TWITTER
  // Communication
  WHATSAPP
  EMAIL
  TELEGRAM
  PHONE
  // Location
  GOOGLE_MAPS
  // Business
  WEBSITE
  PORTFOLIO
  SHOPEE
  TOKOPEDIA
  BOOKING
  PRODUCT_CATALOG
  // Custom
  CUSTOM
}

// ---------------------------------------------------------------------------
// Social Link (icons displayed at top of public profile)
// ---------------------------------------------------------------------------
model SocialLink {
  id        String          @id @default(cuid())
  profileId String          @map("profile_id")
  platform  SocialPlatform
  url       String          @db.Text
  sortOrder Int             @default(0) @map("sort_order")

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@map("social_links")
}

enum SocialPlatform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  FACEBOOK
  LINKEDIN
  X_TWITTER
}

// ---------------------------------------------------------------------------
// Theme
// ---------------------------------------------------------------------------
model Theme {
  id              String      @id @default(cuid())
  profileId       String      @unique @map("profile_id")
  templateName    String      @default("classic") @map("template_name")
  backgroundType  BgType      @default(SOLID) @map("background_type")
  backgroundValue String      @default("#ffffff") @map("background_value")
  primaryColor    String      @default("#000000") @map("primary_color")
  secondaryColor  String      @default("#666666") @map("secondary_color")
  textColor       String      @default("#000000") @map("text_color")
  buttonColor     String      @default("#000000") @map("button_color")
  buttonTextColor String      @default("#ffffff") @map("button_text_color")
  buttonStyle     ButtonStyle @default(ROUNDED) @map("button_style")
  fontFamily      String      @default("Inter") @map("font_family")
  fontSize        String      @default("md") @map("font_size")
  fontWeight      String      @default("normal") @map("font_weight")
  layout          String      @default("center")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  profile         Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("themes")
}

enum BgType {
  SOLID
  GRADIENT
  IMAGE
}

enum ButtonStyle {
  ROUNDED
  PILL
  SQUARE
  GLASS
  OUTLINE
}

// ---------------------------------------------------------------------------
// Analytics Event
// ---------------------------------------------------------------------------
model AnalyticsEvent {
  id        String    @id @default(cuid())
  profileId String    @map("profile_id")
  linkId    String?   @map("link_id")
  eventType EventType @map("event_type")
  createdAt DateTime  @default(now()) @map("created_at")

  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  link      Link?   @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([profileId, eventType])
  @@index([profileId, createdAt])
  @@map("analytics_events")
}

enum EventType {
  PROFILE_VIEW
  LINK_CLICK
}
